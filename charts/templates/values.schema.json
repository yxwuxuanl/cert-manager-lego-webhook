{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["groupName", "webhook", "certManager"],
  "properties": {
    "global": {"type": "object"},
    "tags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "groupName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
    },
    "nameOverride": {"type": "string"},
    "certManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {"type": "string"},
        "serviceAccountName": {"type": "string"}
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"}
          }
        },
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "replicas": {"type": "integer", "minimum": 0},
        "affinity": {
          "description": "A Kubernetes affinity object. An empty array is accepted for compatibility with chart 1.5.0 values.",
          "oneOf": [{"type": "object"}, {"type": "array", "maxItems": 0}]
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {"$ref": "#/definitions/quantities"},
            "limits": {"$ref": "#/definitions/quantities"}
          }
        },
        "envs": {"$ref": "#/definitions/stringMap"},
        "nodeSelector": {"$ref": "#/definitions/stringMap"},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "extraArgs": {"type": "array", "items": {"type": "string"}},
        "dnsConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nameservers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "searches": {"type": "array", "items": {"type": "string"}},
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
              }
            }
          },
          "if": {"minProperties": 1},
          "then": {"required": ["nameservers"]}
        }
      }
    }
  },
  "definitions": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "quantities": {"type": "object", "additionalProperties": {"type": ["string", "number"]}}
  }
}
